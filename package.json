{
  "name": "@agent-score/sdk",
  "version": "2.7.9",
  "description": "TypeScript client for the AgentScore APIs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "lefthook install",
    "prepublishOnly": "bun run build",
    "knip": "knip"
  },
  "keywords": [
    "agentscore",
    "x402",
    "erc-8004",
    "agent",
    "trust",
    "reputation",
    "wallet",
    "blockchain",
    "ai-agent",
    "agentic-payments",
    "mcp",
    "middleware"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentscore/node-sdk"
  },
  "homepage": "https://www.agentscore.com",
  "bugs": {
    "url": "https://github.com/agentscore/node-sdk/issues"
  },
  "engines": {
    "node": ">=22 <25",
    "bun": ">=1.3.0 <2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "knip": "^6.34.0",
    "lefthook": "^2.1.12",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "bun@1.4.0",
  "overrides": {
    "esbuild": "^0.28.1",
    "nanoid": "^3.3.17"
  }
}
